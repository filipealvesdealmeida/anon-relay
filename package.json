{
  "name": "anon-relay",
  "version": "1.0.0",
  "description": "Relay de disparo WhatsApp com retencao zero de numeros. Recebe a lista em memoria, envia, descarta o numero e guarda apenas contadores agregados.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "audit:retention": "node scripts/scan-retention.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.2"
  },
  "license": "UNLICENSED",
  "private": false
}
