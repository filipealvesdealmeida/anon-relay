# ─────────────────────────────────────────────────────────────────────────────
# anon-relay — exemplo de configuracao
#
# Copie para .env e preencha. Nenhum destes valores vai pro repositorio.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3020
NODE_ENV=production

# Redis usado SO para contadores agregados. Pode ser o mesmo Redis do sistema
# principal (o prefixo isola) ou um dedicado.
REDIS_URL=redis://:senha@127.0.0.1:6379
REDIS_PREFIX=anon:
REPORT_TTL_DAYS=30
WAMID_TTL_HOURS=72

# ── Segredos ────────────────────────────────────────────────────────────────
# Gere com:  openssl rand -hex 32
# ANON_PEPPER deriva todos os hashes. Trocar invalida os indices existentes
# (comportamento desejado: o dado antigo vira ruido na hora).
ANON_PEPPER=
# Mesmo valor configurado no .env do sistema principal. Autentica duas coisas:
# os tickets emitidos pelo painel /privado e o repasse de webhook, quando os
# numeros anonimos dividem o App Meta com o sistema principal.
ANON_TICKET_SECRET=

# ── Meta ────────────────────────────────────────────────────────────────────
META_GRAPH_VERSION=v21.0
# Token que a Meta usa pra validar a URL do webhook (GET hub.challenge).
META_WEBHOOK_VERIFY_TOKEN=
# App secret do App Meta dono dos numeros anonimos. Quando preenchido, a
# assinatura X-Hub-Signature-256 de cada webhook e conferida.
META_APP_SECRET=

# Numeros dedicados ao modo anonimo (JSON em uma linha).
# Estes numeros nao devem ser usados pelo sistema principal.
ANON_SENDERS=[{"id":"PHONE_NUMBER_ID","label":"Numero 01","wabaId":"WABA_ID","token":"EAAG..."}]

# ── Disparo ─────────────────────────────────────────────────────────────────
DISPATCH_RATE_PER_SECOND=12
MAX_RECIPIENTS_PER_JOB=50000
MAX_BODY_BYTES=12582912

# Origem do painel que consome esta API (o sistema principal).
ALLOWED_ORIGINS=https://SEU-DOMINIO

# ── Procedencia (preenchidos pelo workflow de deploy) ───────────────────────
BUILD_COMMIT=
IMAGE_DIGEST=
DEPLOYED_AT=
RELEASE_TAG=
SOURCE_REPO=https://github.com/OWNER/anon-relay
