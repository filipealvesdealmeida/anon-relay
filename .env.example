# ─────────────────────────────────────────────────────────────────────────────
# anon-relay — exemplo de configuracao
#
# Copie para .env e preencha. Nenhum destes valores vai pro repositorio.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3020
NODE_ENV=production

# Este servico nao tem banco, fila nem cache. Nao ha o que configurar aqui.

# ── Segredos ────────────────────────────────────────────────────────────────
# Gere tudo com:  node scripts/anon-keygen.js  (no sistema operador)
#
# Chave privada: a UNICA copia. E o que separa este processo de todos os outros.
# O sistema operador tem so a chave publica correspondente.
ANON_PRIVATE_KEY=

# Deriva o HMAC do wamid. Precisa ser identico ao do sistema operador.
ANON_PEPPER=
# Autentica as chamadas do sistema operador. Mesmo valor la e aqui.
ANON_TICKET_SECRET=

# ── Meta ────────────────────────────────────────────────────────────────────
META_GRAPH_VERSION=v21.0

# Numeros dedicados ao modo anonimo (JSON em uma linha).
# Estes numeros nao devem ser usados pelo sistema principal.
ANON_SENDERS=[{"id":"PHONE_NUMBER_ID","label":"Numero 01","wabaId":"WABA_ID","token":"EAAG..."}]

# ── Envio ───────────────────────────────────────────────────────────────────
# Teto de seguranca por numero. O controle principal de vazao e do sistema
# operador (limiter do BullMQ); este aqui e a ultima barreira.
SEND_RATE_PER_SECOND=60
MAX_BODY_BYTES=262144

# Origem permitida (so importa se alguma pagina consultar /version pelo navegador).
ALLOWED_ORIGINS=https://SEU-DOMINIO

# ── Procedencia (preenchidos pelo workflow de deploy) ───────────────────────
BUILD_COMMIT=
IMAGE_DIGEST=
DEPLOYED_AT=
RELEASE_TAG=
SOURCE_REPO=https://github.com/OWNER/anon-relay

